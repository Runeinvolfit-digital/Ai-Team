---
import Site from '../layouts/Site.astro';
import { email } from '../content';
---
<Site title="Contact | Involfit" description="Neem per e-mail contact op met Involfit Management & Advies.">
  <section class="shell reading-page">
    <header class="page-intro">
      <h1>Contact</h1>
      <p>Wilt u een vraagstuk bespreken?</p>
    </header>
    <p>Vertel kort wat er speelt binnen uw organisatie en waar u ondersteuning bij zoekt.</p>
    <p class="next-step"><a href={`mailto:${email}`}>{email}</a></p>
  </section>
</Site>
