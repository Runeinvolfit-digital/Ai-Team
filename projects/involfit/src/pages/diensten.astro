---
import Site from '../layouts/Site.astro';
import Callout from '../components/Callout.astro';
import { services } from '../content';
---
<Site title="Diensten en trainingen | Involfit" description="Bekijk het aanbod van Involfit voor interimmanagement, organisatieadvies, organisatieverbetering en trainingen.">
  <div class="shell">
    <header class="page-intro">
      <h1>Diensten en trainingen<span>.</span></h1>
      <p>Van tijdelijke versterking tot advies over een verandering. Bekijk wat past bij de vraag van uw organisatie.</p>
    </header>
    <section class="catalogue" data-catalogue aria-label="Aanbod">
      <nav class="segments" aria-label="Soort aanbod">
        <a id="tab-diensten" href="#diensten">Diensten</a>
        <a id="tab-trainingen" href="#trainingen">Trainingen</a>
      </nav>
      <div id="diensten" class="offer-panel">
        <h2>Diensten</h2>
        {services.map(service => (
          <article class="service-row" id={service.id}>
            <div><h3>{service.title}</h3><p>{service.summary}</p></div>
            <div>
              <h4>Wanneer past dit?</h4><p>{service.situation}</p>
              <h4>Hoe pakken we het aan?</h4><p>{service.approach}</p>
              <a class="text-link" href={`/contact/?onderwerp=${service.id}`}>Bespreek {service.title.toLowerCase()}</a>
            </div>
          </article>
        ))}
      </div>
      <div id="trainingen" class="offer-panel">
        <h2>Trainingen</h2>
        <article class="service-row">
          <div><h3>Organisatieontwikkeling</h3><p>In kaart brengen hoe rollen, taken en samenwerking in uw organisatie op elkaar aansluiten.</p></div>
          <div><h4>Een mogelijke oefenvraag</h4><p>Welke afspraken hebben teams nodig om samen een besluit te nemen of werk goed over te dragen?</p></div>
        </article>
        <article class="service-row">
          <div><h3>Verandering en verbetering</h3><p>Oefenen met het vertalen van een veranderwens naar een concrete stap in het werk.</p></div>
          <div><h4>Een mogelijke oefenvraag</h4><p>Hoe maakt u een terugkerend knelpunt bespreekbaar en kiest u een verbetering die het team kan uitproberen?</p></div>
        </article>
        <p>Dit zijn trainingsthema’s. Bespreek met Sander welke inhoud en werkvorm passen bij de deelnemers.</p>
        <a class="text-link" href="/contact/?onderwerp=trainingen">Bespreek een training</a>
      </div>
    </section>
  </div>
  <Callout title="Samen de vraag scherp krijgen" text="In een kennismaking bespreekt u waar u tegenaan loopt en welke ondersteuning daarbij past." />
  <script is:inline src="/aanbod.js" defer></script>
</Site>
