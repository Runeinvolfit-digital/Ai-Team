---
import Site from '../layouts/Site.astro';
import { experience, services } from '../content';
---
<Site title="Ervaring | Involfit" description="Bekijk de loopbaan en opdrachten van Sander de Ridder in strategisch management, digitale transformatie en bedrijfsvoering.">
  <section class="shell reading-page">
    <header class="page-intro">
      <h1>Ervaring</h1>
      <p>{experience.length ? "Rollen en opdrachten van Sander de Ridder." : "Dit zijn de organisatievraagstukken waarop ik me richt. De voorbeelden laten zien hoe zo’n vraagstuk eruit kan zien."}</p>
    </header>
    {experience.length > 0 && (
      <ol class="timeline" aria-label="Loopbaan en opdrachten">
        {experience.map(({period, role, organization, description}) => (
          <li><p>{period}</p><h2>{role}</h2>{organization && <p>{organization}</p>}<p>{description}</p></li>
        ))}
      </ol>
    )}
    {experience.length > 0 && (
      <section class="page-section">
        <h2>Eerdere functies</h2>
        <ul>
          <li>Programmamanager overheid bij Sogeti</li>
          <li>Projectmanager bij Friesland Bank</li>
          <li>Projectleider bij Aegon</li>
        </ul>
      </section>
    )}
    {experience.length > 0 && <h2 class="work-areas-heading">Werkgebieden</h2>}
    <ul class="work-areas">
      {services.map(({id, title, summary, example}) => (
        <li id={id}>
          <h2>{title}</h2>
          <div>
            <p>{summary}</p>
            <p><strong>Voorbeeldsituatie</strong> {example}</p>
            <a href={`/diensten/#${id}`}>Bekijk de aanpak</a>
          </div>
        </li>
      ))}
    </ul>
    <p class="next-step"><a href="/contact/">Bespreek uw vraagstuk</a></p>
  </section>
</Site>
