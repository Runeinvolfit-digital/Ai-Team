---
import Site from '../layouts/Site.astro';
import { experience, services } from '../content';
---
<Site title="Ervaring | Involfit" description="Verken de werkgebieden van Sander de Ridder bij Involfit.">
  <section class="shell reading-page">
    <header class="page-intro">
      <h1>Ervaring</h1>
      <p>{experience.length ? "Rollen en opdrachten van Sander de Ridder." : "Werkgebieden van Sander de Ridder."}</p>
    </header>
    {experience.length > 0 && (
      <ol class="timeline" aria-label="Loopbaan en opdrachten">
        {experience.map(({period, role, organization, description}) => (
          <li><p>{period}</p><h2>{role}</h2>{organization && <p>{organization}</p>}<p>{description}</p></li>
        ))}
      </ol>
    )}
    {experience.length > 0 && <h2 class="work-areas-heading">Werkgebieden</h2>}
    <ul class="work-areas">
      {services.map(({id, title, summary}) => (
        <li id={id}><h2>{title}</h2><p>{summary}</p></li>
      ))}
    </ul>
    <p class="next-step"><a href="/contact/">Bespreek uw vraagstuk</a></p>
  </section>
</Site>
