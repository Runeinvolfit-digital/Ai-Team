---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Site from '../layouts/Site.astro';
import { services } from '../content';

const portraits = import.meta.glob<ImageMetadata>(
  '../assets/sander.{avif,jpeg,jpg,png,webp}',
  { eager: true, import: 'default' },
);
const portrait = Object.values(portraits)[0];
---
<Site title="Involfit | Sander de Ridder" description="Sander de Ridder. Management en advies bij groei, ontwikkeling en verandering.">
  <section class="shell hero">
    <div class="hero-copy">
      <h1>Verbeteren betekent veranderen.</h1>
      <p class="hero-name">Sander de Ridder · Involfit Management &amp; Advies</p>
      <p>Uw organisatie groeit, een sleutelrol valt open of een verandering komt niet op gang. Ik help u kiezen wat eerst moet gebeuren en wie het oppakt.</p>
      <div class="hero-actions">
        <a class="hero-contact" href="/contact/">Neem contact op</a>
        <a href="/over-sander/">Maak kennis met Sander</a>
      </div>
    </div>
    {portrait ? (
      <figure class="portrait-frame">
        <Image
          class="portrait"
          src={portrait}
          alt="Sander de Ridder"
          widths={[320, 480, 640]}
          sizes="(max-width: 768px) 256px, 320px"
          format="webp"
          priority
        />
        <figcaption>Sander de Ridder</figcaption>
      </figure>
    ) : (
      <div class="hero-position">
        <h2>Waar loopt u tegenaan?</h2>
        <ul>
          {services.map(({id, opening}) => <li><a href={`/diensten/#${id}`}>{opening}</a></li>)}
        </ul>
      </div>
    )}
  </section>
  <section class="shell introduction">
    <h2>Fit for the job.</h2>
    <div>
      <p>Een goed besluit verandert pas iets als mensen weten wat ze morgen anders moeten doen. Daarom kijk ik samen met uw team naar het werk zelf. Welk besluit blijft liggen? Welke overdracht loopt telkens vast?</p>
      <p>Van daaruit maken we afspraken over de eerstvolgende stap, wie die zet en wanneer we samen bekijken of de aanpak werkt.</p>
    </div>
  </section>
  <section class="shell home-offer" aria-labelledby="aanbod-kop">
    <h2 id="aanbod-kop">Diensten en trainingen</h2>
    <nav class="expertise-links" aria-label="Diensten en trainingen van Involfit">
      {services.map(({id, title, summary}) => (
        <a class="expertise-card" href={`/diensten/#${id}`}>
          <strong>{title}</strong>
          <span>{summary}</span>
        </a>
      ))}
      <a class="expertise-card" href="/diensten/#trainingen">
        <strong>Trainingen</strong>
        <span>Oefen met uw team aan een vraagstuk uit de eigen organisatie.</span>
      </a>
    </nav>
  </section>
</Site>
